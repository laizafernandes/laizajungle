# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=jungle
DB_PASSWORD=jungle_secret
DB_NAME=jungle_wagering
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=3000

# Out-of-order PENDING_REFERENCE Worker
PENDING_REF_WORKER_ENABLED=true
PENDING_REF_BASE_DELAY_MS=1000
PENDING_REF_MAX_DELAY_MS=30000
PENDING_REF_MAX_ATTEMPTS=5
PENDING_REF_TTL_MS=300000
PENDING_REF_POLL_INTERVAL_MS=1000
PENDING_REF_BATCH_SIZE=50

# AWS SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://127.0.0.1:4566
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_MAX_RECEIVE_COUNT=3
