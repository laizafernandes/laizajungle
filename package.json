{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Jungle Gaming Technical Challenge — Distributed Wagering Processor",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts && tsc --noEmit",
    "lint:fix": "biome check --write src test scripts",
    "format": "biome format --write src test scripts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down -v",
    "infra:wait": "bun run scripts/wait-for-infra.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test test/unit",
    "test:integration": "bun run scripts/wait-for-infra.ts && bun test test/integration",
    "test:concurrency": "bun run scripts/wait-for-infra.ts && bun test test/concurrency",
    "test:load": "bun run scripts/wait-for-infra.ts && bun run scripts/load-test.ts",
    "migration:up": "bun run scripts/migrations.ts up",
    "migration:down": "bun run scripts/migrations.ts down",
    "migration:status": "bun run scripts/migrations.ts status"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1166.0",
    "@mikro-orm/core": "6.4.3",
    "@mikro-orm/migrations": "6.4.3",
    "@mikro-orm/nestjs": "6.1.0",
    "@mikro-orm/postgresql": "6.4.3",
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "decimal.js": "10.4.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@nestjs/testing": "10.4.15",
    "@types/bun": "1.4.4",
    "typescript": "5.7.2"
  }
}
